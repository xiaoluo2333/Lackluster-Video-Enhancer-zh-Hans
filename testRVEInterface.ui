QCheckBox::indicator:unchecked{
    border : 1px solid white;
    border-radius: 2px;
    width: 14px;
    height: 14px;
    left: 2px;
}
QCheckBox::indicator:checked {
    image: url(:/icons/icons/check-square.svg);
    color: white;
    border-radius: 2px;
    width: 20px;
    height: 20px;
}

QScrollBar:vertical{
	max-width: 8px;
	}
QScrollBar:horizontal{
	max-height: 8px;
	}
QScrollBar::handle{
		border-radius:4px;
        background: #fff;
}


        QScrollBar::handle:vertical:hover {
            background: gray;
        }

        QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
            border: none;
            background: transparent;
            width: 0px;
            height: 0px;
        }

        QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
            border: none;
            background: none;
        }

        /* Horizontal scrollbar */
        

        QScrollBar::handle:horizontal:hover {
            background: #0c66c2;
        }

        QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
            border: none;
            background: #f0f0f0;
            height: 0px;
            width: 0px;
        }

        QScrollBar::left-arrow:horizontal, QScrollBar::right-arrow:horizontal {
            border: none;
            background: none;
        }

QScrollBar:vertical{
		background:transparent; /*change background here*/
		color:#2c313c;
}
QScrollBar:horizontal{
		background:#2c313c; /*change background here*/
		color:transparent;
}
QTabWidget::pane { /* The tab widget frame */
                border-top: 0px solid #C2C7CB;
                top: -0.5em;
                background: transparent;
            }

            QTabWidget::tab-bar {
                alignment: left;
            }

            QTabBar::tab {
                background: #1f232a;
                border: 0px solid #C4C4C3;
                border-bottom-color: #C2C7CB; /* same as the pane color */
                border-top-left-radius: 4px;
                border-top-right-radius: 4px;
				  border-bottom-left-radius: 4px;
                border-bottom-right-radius: 4px;
                min-width: 8ex;
                padding: 6px;
				 color: #fff;
            }

            QTabBar::tab:selected{
                background:#676e7b;
            }
            QTabBar::tab:hover {
				background: #343b47;
				}

            QTabBar::tab:selected {
                border-color: transparent;
                border-bottom-color: transparent; /* same as pane color */
            }

            QTabBar::tab:!selected {
                margin-top: 2px; /* make non-selected tabs look smaller */
            }

            QTabBar::tab:selected {
                /* expand/overlap to the left and right by 4px */
                margin-left: 2px;
                margin-right: 2px;
            }

            QTabBar::tab:first:selected {
                margin-left: 0; /* the first selected tab should not overlap */
            }

            QTabBar::tab:last:selected {
                margin-right: 0; /* the last selected tab should not overlap */
            }

            QTabBar::tab:only-one {
                margin: 0; /* if there is only one tab, it should not overlap */
            }
</string>
