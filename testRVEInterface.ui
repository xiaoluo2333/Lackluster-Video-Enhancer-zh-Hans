             <property name="styleSheet">
              <string notr="true">QWidget{
background-color:#16191d

}
QScrollArea{
	background:transparent;
}
QLineEdit{
background-color:#2c313c;
border-radius: 10px;
}
QSpinBox{
	background-color:#2c313c;
	padding:5px 10px;
	border-radius: 10px;
	color:white;
}
QSpinBox::up-arrow {
       
		image: url(:/icons/icons/arrow-up.svg); 
    }
QSpinBox::down-arrow {

        image: url(:/icons/icons/arrow-down.svg); 
		
    }
QSpinBox::up-button {
        width: 20px;
        height: 15px;
    }
QSpinBox::down-button {
        width: 20px;
        height: 15px;
    }
QTextEdit{
background-color:#2c313c;
border-radius: 10px;
padding:5px 10px;
}

QPushButton{
    background-color:#2c313c;
	text-align:left;
	padding:5px 10px;
	border-radius: 10px;
}
QPushButton:checked{
	background-color:#676e7b;
}
QPushButton:hover{
	background-color:#343b47;
}

QComboBox{
background-color:#2c313c;
	text-align:left;
	padding:5px 10px;
	border-radius: 10px;
color:white;
}

QProgressBar{
    background-color:#2c313c;
	border-radius: 10px;

}
 QProgressBar::chunk {
     background-color:white;
	text-align:left;
	border-radius: 10px;
	
 }


Line{
color:white;
background-color:white;
}
QDoubleSpinBox{
	background-color:#2c313c;
	padding:5px 10px;
	border-radius: 10px;
	color:white;
}
QDoubleSpinBox::up-arrow {
       
		image: url(:/icons/icons/arrow-up.svg); 
    }
QDoubleSpinBox::down-arrow {

        image: url(:/icons/icons/arrow-down.svg); 
		
    }
QDoubleSpinBox::up-button {
        width: 20px;
        height: 15px;
    }
QDoubleSpinBox::down-button {
        width: 20px;
        height: 15px;
    }
QTabWidget::pane { /* The tab widget frame */
                border-top: 0px solid #C2C7CB;
                top: -0.5em;
                background: transparent;
            }

            QTabWidget::tab-bar {
                alignment: left;
            }

            QTabBar::tab {
                background: #1f232a;
                border: 0px solid #C4C4C3;
                border-bottom-color: #C2C7CB; /* same as the pane color */
                border-top-left-radius: 4px;
                border-top-right-radius: 4px;
				  border-bottom-left-radius: 4px;
                border-bottom-right-radius: 4px;
                min-width: 8ex;
                padding: 6px;
				  color: #fff;
            }

            QTabBar::tab:selected{
                background:#676e7b;
            }
            QTabBar::tab:hover {
				background: #343b47;
				}

            QTabBar::tab:selected {
                border-color: transparent;
                border-bottom-color: transparent; /* same as pane color */
            }

            QTabBar::tab:!selected {
                margin-top: 2px; /* make non-selected tabs look smaller */
            }

            QTabBar::tab:selected {
                /* expand/overlap to the left and right by 4px */
                margin-left: 2px;
                margin-right: 2px;
            }

            QTabBar::tab:first:selected {
                margin-left: 0; /* the first selected tab should not overlap */
            }

            QTabBar::tab:last:selected {
                margin-right: 0; /* the last selected tab should not overlap */
            }

            QTabBar::tab:only-one {
                margin: 0; /* if there is only one tab, it should not overlap */
            }</string>
